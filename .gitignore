# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/

# Virtual environments
.venv/
venv/
env/

# Data — the raw source dataset IS committed (small, ~1MB, and GitHub Actions
# needs it to run the pipeline from a clean checkout). Only the GENERATED
# file (produced by src/spark_ingest.py) is excluded.
data/spark_cleaned_churn.csv
data/best_run_id.txt
!data/raw_telco_churn.csv
!data/.gitkeep

# MLflow — local tracking store + full multi-trial artifact history.
# NOTE: deployed_model/ is a SEPARATE, small, single-model folder produced by
# src/export_champion.py -- it is intentionally NOT excluded, since it's
# what the deployed API loads (see src/serve.py's load_champion_pipeline()).
mlflow.db
mlruns/
mlartifacts/

# Model binaries — only relevant for ad-hoc local experiments, not the
# committed deployed_model/ folder above.
*.pkl
*.joblib
*.xgb
!deployed_model/**

# Secrets — never commit credentials
.env
*.pem
.streamlit/secrets.toml

# Jupyter
.ipynb_checkpoints/

# Spark
spark-warehouse/
derby.log
metastore_db/

# OS
.DS_Store
Thumbs.db