# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/

# Virtual environments
.venv/
venv/
env/

# Data — the raw source dataset IS committed (small, ~1MB, and GitHub Actions
# needs it to run the pipeline from a clean checkout). Only the GENERATED
# file (produced by src/spark_ingest.py) is excluded.
data/spark_cleaned_churn.csv
data/best_run_id.txt
!data/raw_telco_churn.csv
!data/.gitkeep

# MLflow — local tracking store, regenerated by running src/train.py
mlflow.db
mlruns/
mlartifacts/

# Model binaries — these belong in the MLflow registry, not git
*.pkl
*.joblib
*.xgb

# Secrets — never commit credentials
.env
*.pem

# Jupyter
.ipynb_checkpoints/

# Spark
spark-warehouse/
derby.log
metastore_db/

# OS
.DS_Store
Thumbs.db